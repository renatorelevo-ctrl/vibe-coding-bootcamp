# Vorlage: kopieren nach .env.devteam (liegt in .gitignore, landet nie auf GitHub)
#   cp .env.devteam.example .env.devteam
# Beim Standard (codex) ist diese Datei optional — es wird kein API-Key gebraucht.

# Welches Backend der Worker nutzt: "codex" (Standard, läuft über ChatGPT Plus),
# "deepseek" oder "glm" (per API-Key, Fallback wenn das OpenAI-Wochenlimit kneift)
WORKER_PROVIDER="codex"

# Nur für WORKER_PROVIDER="codex": Modell für den Worker.
# Leer lassen ("") = Codex-Standardmodell (falls Luna in deiner CLI-Version fehlt).
CODEX_WORKER_MODEL="gpt-5.6-luna"

# Nur für WORKER_PROVIDER="deepseek": Key von https://platform.deepseek.com
# (Pay-as-you-go, kein Zeitfenster-Limit, Cent-Beträge)
DEEPSEEK_API_KEY=""

# Nur für WORKER_PROVIDER="glm": Key von https://z.ai (GLM Coding Plan)
GLM_API_KEY=""
