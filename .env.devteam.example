# Vorlage: kopieren nach .env.devteam (liegt in .gitignore, landet nie auf GitHub)
#   cp .env.devteam.example .env.devteam

# Welches Backend der Worker nutzt: "deepseek" oder "glm"
WORKER_PROVIDER="deepseek"

# DeepSeek: Key von https://platform.deepseek.com (Pay-as-you-go, kein Zeitfenster-Limit)
DEEPSEEK_API_KEY=""

# Z.ai GLM: Key von https://z.ai (GLM Coding Plan), nur nötig bei WORKER_PROVIDER="glm"
GLM_API_KEY=""
